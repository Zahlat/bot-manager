{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make check)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(uv run *)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(git commit *)",
      "Bash(docker *)",
      "PowerShell(uv add *)",
      "PowerShell(git commit *)",
      "PowerShell(docker *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.prod)",
      "Read(./.env.staging)",
      "Read(./deploy/secrets/**)",
      "Bash(git push *)",
      "PowerShell(git push *)"
    ]
  }
}
