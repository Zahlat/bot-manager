# Copy to .env and fill in. .env is git-ignored. Never paste real values into prompts.
APP_ENV=dev                     # dev | staging | prod

# Telegram (dev bot from @BotFather — never the prod token)
BOT_TOKEN=
BOT_KEY=dev                     # identifies this bot in telegram_files
WEBHOOK_SECRET=                 # 1-256 chars of A-Z a-z 0-9 _ -
WEBHOOK_PATH=                   # 32 random chars
CALLBACK_HMAC_KEY=

# Postgres / Redis (match docker-compose.dev.yml)
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=bot
DATABASE_URL=postgresql+asyncpg://bot:change-me-dev@localhost:5432/bot
REDIS_PASSWORD=change-me-dev
REDIS_URL=redis://:change-me-dev@localhost:6379/0

# Storage
STORAGE_BACKEND=local           # local | s3
STORAGE_LOCAL_DIR=./var/storage
